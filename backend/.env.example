ANTHROPIC_API_KEY=
# Optional: override the Claude model (defaults to claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/log_anomaly
JWT_SECRET=change-me-in-production
PORT=3001
# Origin allowed by CORS (the Next.js frontend).
# Local dev: http://localhost:3000  |  Production: your Vercel URL.
FRONTEND_URL=http://localhost:3000

# Set to "production" when deploying (Railway). Enables Secure + SameSite=None
# cookies so auth works cross-domain (Vercel frontend -> Railway backend).
# NODE_ENV=production
# FRONTEND_URL=https://your-app.vercel.app
